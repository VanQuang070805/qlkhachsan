# Google Gemini API Configuration (Server-side only)
GOOGLE_API_KEY=
GEMINI_CHAT_MODEL=gemini-flash-lite-latest
GEMINI_FALLBACK_CHAT_MODEL=gemini-3.1-flash-lite
GEMINI_MAX_RETRIES=0
GEMINI_REQUEST_TIMEOUT_MS=20000
GEMINI_EMBEDDING_MODEL=text-embedding-004

# Local Vector Store Provider ('mysql', 'supabase', or 'memory')
VECTOR_PROVIDER=mysql
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=qlkhachsan

# Internal Laravel Live Room Tools Connection
LARAVEL_INTERNAL_API_URL=http://127.0.0.1:18084/api
LARAVEL_TOOL_API_KEY=

# Internal Server Authentication (Laravel -> LangGraph Node server)
LANGGRAPH_HOST=127.0.0.1
LANGGRAPH_PORT=2024
LANGGRAPH_INTERNAL_API_KEY=

# Optional: LangSmith for tracing (development only; never expose to browser)
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=royal-hotel-chatbot-dev
