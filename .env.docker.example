# ==============================================================================
# Rosaliza Hotel — Docker Compose Environment Template (.env.docker.example)
# Copy to .env.docker before running:
#   docker compose --env-file .env.docker up -d --build
# ==============================================================================

COMPOSE_PROJECT_NAME=royal-hotel-nhom10-v2
APP_NAME="Rosaliza Hotel"
APP_ENV=local
APP_DEBUG=false
APP_KEY=base64:REPLACE_WITH_GENERATED_APP_KEY
APP_TIMEZONE=Asia/Ho_Chi_Minh

# Three Independent Portal Ports (Host -> Container :80)
CUSTOMER_PORT=18080
STAFF_PORT=18081
ADMIN_PORT=18082

CUSTOMER_PORTAL_URL=http://localhost:18080
STAFF_PORTAL_URL=http://localhost:18081
ADMIN_PORTAL_URL=http://localhost:18082

# Database Bootstrap ('snapshot' imports database/qlkhachsan.sql once on fresh volume; 'migrate-seed' runs migrations + seeders)
DB_BOOTSTRAP_MODE=snapshot
DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=qlkhachsan
DB_USERNAME=royal_app
DB_PASSWORD=change-me
MYSQL_ROOT_PASSWORD=change-me

# Session (must remain 'database' for password-change session revocation)
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax
SESSION_SECURE_COOKIE=false
SESSION_DOMAIN=null

# Dual Redis Services ('redis-cache' with allkeys-lru & 'redis-queue' with noeviction + AOF)
CACHE_STORE=redis
CACHE_PREFIX=royal-hotel-nhom10-v2
REDIS_CLIENT=phpredis
REDIS_HOST=redis-cache
REDIS_PORT=6379
REDIS_PASSWORD=null
REDIS_DB=0
REDIS_CACHE_DB=1

QUEUE_CONNECTION=redis
REDIS_QUEUE_CONNECTION=queue
REDIS_QUEUE_HOST=redis-queue
REDIS_QUEUE_PORT=6379
REDIS_QUEUE_DB=0
REDIS_QUEUE=laravel-default

# Google Gemini + Self-Hosted LangGraph Chatbot
GOOGLE_API_KEY=
GEMINI_CHAT_MODEL=gemini-flash-lite-latest
GEMINI_FALLBACK_CHAT_MODEL=gemini-3.1-flash-lite
GEMINI_MAX_RETRIES=0
GEMINI_REQUEST_TIMEOUT_MS=20000
GEMINI_EMBEDDING_MODEL=gemini-embedding-001

LANGGRAPH_ENABLED=true
LANGGRAPH_BASE_URL=http://chatbot-api:2024
LANGGRAPH_INTERNAL_API_KEY=replace-with-a-long-random-internal-key
LANGGRAPH_TIMEOUT=60
LANGGRAPH_RETRIEVAL_ASSISTANT_ID=retrieval_graph
LANGGRAPH_INGESTION_ASSISTANT_ID=ingestion_graph
LANGGRAPH_VECTOR_PROVIDER=mysql
LANGGRAPH_TOOL_API_KEY=replace-with-a-long-random-tool-key
LANGGRAPH_LIVE_TOOLS_ENABLED=true
LANGGRAPH_CAPABILITY_TTL=90
CHATBOT_WORKER_CONCURRENCY=2

# Optional LangSmith Tracing (server-side only)
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=royal-hotel-chatbot-docker

# Kafka KRaft Single-Node Local Event Broker
KAFKA_BROKERS=kafka:9092
KAFKA_CLIENT_ID=royal-hotel-nhom10-v2
KAFKA_CLUSTER_ID=MkU3OEVBNTcwNTJENDM2Qk

# External Face ID / IoT (Host PC & LAN Raspberry Pi — not containerized)
FACE_PC_SERVICE_URL=http://host.docker.internal:8001
DEVICE_API_KEY=change-me
