APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax
SESSION_SECURE_COOKIE=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync

CACHE_STORE=file
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="your-email@gmail.com"
MAIL_FROM_NAME="Posh Boutique"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Google OAuth (customer portal only)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI="${APP_URL}/auth/google/callback"

# Legacy AI settings for the offline knowledge-indexing command only. The website chatbot uses Dify.
ROYAL_AI_API_KEY=
ROYAL_AI_ENDPOINT=https://api.openai.com/v1/chat/completions
ROYAL_AI_MODEL=gpt-4o-mini
ROYAL_AI_EMBEDDING_MODEL=text-embedding-3-small
ROYAL_AI_VECTOR_STORE_ID=
ROYAL_AI_MODERATION=true

# Self-hosted Dify Chatflow. Keep both credentials on the Laravel server.
DIFY_BASE_URL=
DIFY_API_KEY=
DIFY_TIMEOUT=90
DIFY_TOOL_API_KEY=
DIFY_LIVE_TOOLS_ENABLED=false

# Payment gateway credentials. Configure only the providers you enable.
# Never replace these placeholders with real credentials in this public repository.
VIETQR_BANK_BIN=
VIETQR_ACCOUNT_NO=
VIETQR_ACCOUNT_NAME=
SEPAY_TOKEN=
SEPAY_API_URL=
MOMO_PARTNER_CODE=
MOMO_ACCESS_KEY=
MOMO_SECRET_KEY=
MOMO_ENDPOINT=
MOMO_RETURN_URL=
ZALOPAY_APP_ID=
ZALOPAY_KEY1=
ZALOPAY_KEY2=
ZALOPAY_ENDPOINT=
VNPAY_TMN_CODE=
VNPAY_HASH_SECRET=
VNPAY_URL=

# Optional demo account passwords used by DatabaseSeeder in local/testing.
# Set strong values before running `php artisan db:seed`.
LOCAL_ADMIN_PASSWORD=
LOCAL_RECEPTION_PASSWORD=
LOCAL_CUSTOMER_PASSWORD=

# Optional local face-recognition and Raspberry Pi integrations (leave credentials blank in Git).
FACE_PC_SERVICE_URL=http://127.0.0.1:8001
FACE_PI_BASE_URL=http://127.0.0.1:8002
FACE_API_KEY=
FACE_REQUEST_TIMEOUT=5
FACE_CONNECT_TIMEOUT=2
FACE_SYNC_RETRY_INTERVAL=15
FACE_SYNC_IMMEDIATELY=true
FACE_PI_ROOM_NUMBER=501
FACE_DUPLICATE_THRESHOLD=0.65
IOT_DEVICE_API_KEY=
IOT_CLEANING_ROOM_NUMBER=501
IOT_PI_CAMERA_MODEL="Raspberry Pi Camera Module Rev 1.3"
