FROM alpine:3.20

RUN apk add --no-cache \
    bash \
    mariadb-client \
    php83 \
    php83-cli \
    php83-pdo \
    php83-pdo_mysql \
    php83-mysqlnd \
    php83-mbstring \
    php83-intl \
    php83-bcmath \
    php83-pcntl \
    php83-opcache \
    php83-zip \
    php83-openssl \
    php83-tokenizer \
    php83-xml \
    php83-simplexml \
    php83-xmlwriter \
    php83-dom \
    php83-fileinfo \
    php83-curl \
    php83-session \
    php83-phar \
    php83-iconv \
    php83-ctype \
    && ln -sf /usr/bin/php83 /usr/bin/php

WORKDIR /var/www/html

COPY composer.json composer.lock artisan /var/www/html/
COPY vendor /var/www/html/vendor
COPY docker /var/www/html/docker
COPY docker/php/local-entrypoint.sh /usr/local/bin/local-entrypoint.sh

RUN sed -i 's/\r$//' /usr/local/bin/local-entrypoint.sh \
    && chmod +x /usr/local/bin/local-entrypoint.sh \
    && mkdir -p storage/framework/cache/data \
                storage/framework/sessions \
                storage/framework/views \
                storage/logs \
                bootstrap/cache

ENTRYPOINT ["/usr/local/bin/local-entrypoint.sh"]
