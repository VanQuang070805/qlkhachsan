FACE_API_KEY=replace-with-a-long-random-secret
FACE_API_HOST=0.0.0.0
FACE_API_PORT=8002
FACE_DB_PATH=data/faces.db
PI_CAMERA_INDEX=0
PI_CAMERA_WIDTH=640
PI_CAMERA_HEIGHT=480
PI_CAMERA_FRAMERATE=15
PI_CAMERA_WARMUP_SECONDS=1
YUNET_MODEL_PATH=models/face_detection_yunet_2023mar.onnx
SFACE_MODEL_PATH=models/face_recognition_sface_2021dec.onnx
DETECTION_THRESHOLD=0.9
RECOGNITION_THRESHOLD=0.363
PROCESS_EVERY_N_FRAMES=3
REQUEST_TIMEOUT=5
CAMERA_RECONNECT_INITIAL=1
CAMERA_RECONNECT_MAX=15
START_RECOGNITION=false
SHOW_PREVIEW=true
SERVO_ENABLED=false
SERVO_GPIO_PIN=18
SERVO_CLOSED_ANGLE=0
SERVO_OPEN_ANGLE=90
SERVO_MOVE_SECONDS=1.2
SERVO_HOLD_SECONDS=3
SERVO_COOLDOWN_SECONDS=8
SERVO_MIN_PULSE_WIDTH=0.0005
SERVO_MAX_PULSE_WIDTH=0.0025
SERVO_DETACH_AFTER_MOVE=true
SERVO_PWM_BACKEND=pigpio

# Room 501 cleaning switch -> Laravel on the receptionist laptop.
CLEANING_SWITCH_ENABLED=true
HOTEL_API_BASE_URL=http://192.168.1.10:8000
IOT_DEVICE_API_KEY=replace-with-the-same-private-key-as-laravel
IOT_CLEANING_ROOM_NUMBER=501
IOT_CLEANING_SWITCH_GPIO=17
IOT_SWITCH_BOUNCE_TIME=0.15
IOT_REQUEST_TIMEOUT=5
IOT_RETRY_SECONDS=3
