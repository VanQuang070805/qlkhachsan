# Shell variables, NOT Laravel .env. Load with: set -a; . ./.env; set +a
PI_CAMERA_INDEX=0
PI_CAMERA_WIDTH=640
PI_CAMERA_HEIGHT=480
PI_CAMERA_FRAMERATE=15
PI_CAMERA_WARMUP_SECONDS=1
CAMERA_RECONNECT_INITIAL=1
CAMERA_RECONNECT_MAX=15

# Laptop running Laravel. Use its LAN IPv4 address, not 127.0.0.1.
HOTEL_API_BASE_URL=http://192.168.1.10:8000
IOT_DEVICE_API_KEY=replace-with-the-same-private-key-as-laravel
IOT_CLEANING_ROOM_NUMBER=501
# BCM numbering: GPIO17 is physical pin 11 on the 40-pin header.
IOT_CLEANING_SWITCH_GPIO=17
IOT_SWITCH_BOUNCE_TIME=0.08
IOT_REQUEST_TIMEOUT=5
IOT_RETRY_SECONDS=3
